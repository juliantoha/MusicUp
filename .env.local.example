# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Required for seed script - DO NOT commit this key to version control
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Email Configuration
# Required for sending booking confirmations, concert reminders, and venue reminders
# Get your API key at https://resend.com
RESEND_API_KEY=your-resend-api-key-here

# Email sender address (must be verified in Resend dashboard)
FROM_EMAIL=onboarding@resend.dev

# Application URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Job Configuration
# Secret token for securing cron endpoints (generate a random string)
CRON_SECRET=your-cron-secret-here

# API Key for manual testing of cron endpoints (generate a random string)
API_KEY=your-api-key-here
